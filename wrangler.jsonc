{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "abap-collab",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/collaboration/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COLLABORATION_ROOMS",
        "class_name": "CollaborationRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CollaborationRoom"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
